# ===========================================
# PSSE Backend Environment Configuration
# ===========================================

# Database Configuration (Neon.tech PostgreSQL)
# Replace with your actual Neon database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL='postgresql://neondb_owner:'


# EMAIL CONFIGURATION (Resend)
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USER=resend
MAIL_PASSWORD=password
MAIL_FROM="Admin <admin@yourdomain.com>"
# If you verified a domain, change the above to "PSSE Admin <admin@yourdomain.com>"

FRONTEND_URL='http://localhost:5173'

JWT_SECRET="your_jwt_secret"
JWT_ACCESS_EXPIRES_IN='15m'
JWT_REFRESH_EXPIRES_IN='7d'
JWT_REFRESH_SECRET="your_refresh_jwt_secret"

# Application Configuration
PORT=3000
NODE_ENV=development

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret