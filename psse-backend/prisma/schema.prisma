// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// PSSE Organization Website - Database Schema
// Using PostgreSQL hosted on Neon.tech

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ===========================================
// Enums
// ===========================================

enum Role {
  MEMBER
  ADMIN
}

enum Category {
  LANYARD
  TSHIRT
  STICKER
}

enum OrderStatus {
  PENDING_REVIEW
  AWAITING_PAYMENT
  READY_PICKUP
  COMPLETED
  CANCELLED
}

// ===========================================
// Models
// ===========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(MEMBER)
  studentId String?
  createdAt DateTime @default(now())

  @@map("users")
}

model Officer {
  id           String @id @default(uuid())
  name         String
  position     String
  category     String
  photoUrl     String
  academicYear String
  order        Int    @default(0)

  @@map("officers")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  date        DateTime
  imageUrl    String
  location    String
  isUpcoming  Boolean  @default(true)

  @@map("events")
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String
  price       Decimal     @db.Decimal(10, 2)
  stock       Int
  category    Category
  imageUrl    String
  isFeatured  Boolean     @default(false)
  orderItems  OrderItem[]

  @@map("products")
}

model Order {
  id            String      @id @default(uuid())
  customerName  String
  studentId     String
  contactNumber String
  customerEmail String
  totalAmount   Decimal     @db.Decimal(10, 2)
  status        OrderStatus @default(PENDING_REVIEW)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Int
  priceAtTime Decimal @db.Decimal(10, 2)

  @@map("order_items")
}
